# ===========================================
# Configuration du serveur Ophtalmic Middleware
# ===========================================
# Copiez ce fichier en .env et remplissez les valeurs

# -------------------------------------------
# Configuration serveur Express
# -------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------
# Configuration Shopify
# -------------------------------------------
# URL de votre boutique Shopify (format: votre-boutique.myshopify.com)
SHOPIFY_STORE_URL=hydrofeel-larmes.myshopify.com

# Token d'accès API Admin Shopify (créé dans Settings > Apps > Develop apps)
SHOPIFY_ACCESS_TOKEN=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salah

# Secret du webhook Shopify (pour vérifier la signature HMAC)
SHOPIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de l'item d'inventaire du produit Hydrofeel sur Shopify
# Trouvable via l'API : GET /admin/api/2024-01/products/{product_id}/variants.json
SHOPIFY_INVENTORY_ITEM_ID=

# ID de l'emplacement de stockage Shopify
# Trouvable via l'API : GET /admin/api/2024-01/locations.json
SHOPIFY_LOCATION_ID=

# -------------------------------------------
# Configuration Sage X3 - Webservice SOAP
# -------------------------------------------
# URL du WSDL Sage X3 (dev ou prod)
# Dev: https://x3v12webservice-dev.ophtalmic.fr:4433/soap-wsdl/syracuse/collaboration/syracuse/CAdxWebServiceXmlCC?wsdl
# Prod: https://x3v12webservice-prod.ophtalmic.fr/soap-wsdl/syracuse/collaboration/syracuse/CAdxWebServiceXmlCC?wsdl
SAGE_X3_WSDL_URL=https://x3v12webservice-dev.ophtalmic.fr:4433/soap-wsdl/syracuse/collaboration/syracuse/CAdxWebServiceXmlCC?wsdl

# Credentials d'authentification Sage X3
SAGE_X3_USER=WBSRV
SAGE_X3_PASSWORD=wbsrv14

# Alias du pool de base de données (DOPHTA pour dev, POHTA pour prod)
SAGE_X3_POOL_ALIAS=POHTA

# Code du site de stockage
SAGE_X3_SITE=OPL

# Nom public du webservice Sage X3
SAGE_X3_PUBLIC_NAME=YSSTODIS

# -------------------------------------------
# Configuration Produit
# -------------------------------------------
# Code EAN du produit Hydrofeel Larmes
HYDROFEEL_EAN=3661484004792

# -------------------------------------------
# Configuration SFTP
# -------------------------------------------
SFTP_HOST=sftp.ophtalmic.fr
SFTP_PORT=22
SFTP_USER=LSRAgence
SFTP_PASSWORD=salah2001
# Dossier de destination sur le serveur SFTP (à confirmer avec le client)
SFTP_REMOTE_DIR=/

# -------------------------------------------
# Configuration du mode test
# -------------------------------------------
# Si true, les fichiers sont sauvegardés localement au lieu d'être envoyés sur SFTP
TEST_MODE=true
# Dossier local pour les fichiers de test
LOCAL_DOWNLOAD_DIR=./test_files/

# -------------------------------------------
# Configuration des logs
# -------------------------------------------
# Niveau de log (error, warn, info, http, verbose, debug)
LOG_LEVEL=info
# Durée de rétention des logs en jours
LOG_RETENTION_DAYS=30

# -------------------------------------------
# Configuration du cron de synchronisation stock
# -------------------------------------------
# Expression cron pour la synchronisation du stock (par défaut: toutes les heures)
# Format: seconde minute heure jour-du-mois mois jour-de-la-semaine
STOCK_SYNC_CRON=0 0 * * * *

# Activer/désactiver la synchronisation automatique du stock
STOCK_SYNC_ENABLED=true

# -------------------------------------------
# Configuration Fixie Socks (Proxy IP statique)
# -------------------------------------------
# URL du proxy SOCKS5 Fixie (fourni par Heroku addon)
# Format: username:password@host:port
# Exemple: fixie:TOKEN@bici.usefixie.com:1080
# Laissez vide pour désactiver le proxy
FIXIE_SOCKS_HOST=

# IPs statiques sortantes (fournies par Fixie, à whitelister chez le client)
# Ces IPs sont affichées dans le dashboard Fixie après installation de l'addon
# Exemple: 52.209.179.93, 52.51.139.66

# -------------------------------------------
# Configuration de sécurité
# -------------------------------------------
# Liste des IPs autorisées pour les webhooks (séparées par des virgules, vide = toutes)
ALLOWED_IPS=

# Timeout pour les appels API en millisecondes
API_TIMEOUT=30000

# Nombre de tentatives en cas d'échec réseau
MAX_RETRIES=3
